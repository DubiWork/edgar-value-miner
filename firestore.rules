rules_version = '2';

// ============================================================
// EDGAR Value Miner — Firestore Security Rules
// Issue #145 — A2: Firestore Security Rules & Emulator-Based Rule Tests
//
// Two-layer data model:
//   Global Layer  — debates/{ticker_version}  — public read, CF-only write
//   Personal Layer — users/{uid}/...           — owner-only read/write
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Helper functions
    // ----------------------------------------------------------

    // Is the request from a signed-in user?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Does the requesting user own this uid path segment?
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ----------------------------------------------------------
    // debates/{debateId}
    //
    // Global layer — generated by Cloud Functions (admin SDK).
    // - Any authenticated user may read.
    // - Client writes are DENIED; only the admin SDK bypasses rules.
    // ----------------------------------------------------------
    match /debates/{debateId} {
      allow read:  if isAuthenticated();
      allow write: if false;  // CF admin SDK bypasses this by design

      // --------------------------------------------------------
      // debates/{debateId}/feedback/{uid}
      //
      // Feedback is written by the authenticated user whose uid
      // matches the path segment.  Cloud Functions may also read
      // all feedback via the admin SDK.
      // --------------------------------------------------------
      match /feedback/{uid} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if false;
      }
    }

    // ----------------------------------------------------------
    // users/{uid}
    //
    // Personal layer root document — owner-only.
    // ----------------------------------------------------------
    match /users/{uid} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid);

      // ------------------------------------------------------
      // users/{uid}/notes/{ticker}
      //
      // Personal research notes — owner-only.
      // ------------------------------------------------------
      match /notes/{ticker} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid);
      }

      // ------------------------------------------------------
      // users/{uid}/watchlist/{ticker}
      //
      // Personal watchlist entries — owner-only.
      // ------------------------------------------------------
      match /watchlist/{ticker} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid);
      }
    }

    // ----------------------------------------------------------
    // Default deny — any path not matched above is rejected.
    // This catch-all must remain LAST.
    // ----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
